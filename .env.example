# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Your Telegram User ID (for whitelist - get from @userinfobot)
ALLOWED_TELEGRAM_USER_ID=your-telegram-user-id

# API Bearer Token (generate a random string)
API_BEARER_TOKEN=your-secret-api-token

# Todoist API Token
TODOIST_API_TOKEN=your-todoist-api-token

# Linear API Keys — comma-separated, one per org (Settings > Security & access > Personal API keys)
LINEAR_API_KEYS=lin_api_mitzi_key,lin_api_retrotype_key

# Groq API Key (for Whisper transcription of Telegram voice messages)
GROQ_API_KEY=your-groq-api-key

# Ramble Webhook Secret (optional - copy from Ramble app Settings screen)
RAMBLE_WEBHOOK_SECRET=your-ramble-webhook-secret

# OpenAI API Key (required — used for embeddings + dedup LLM)
OPENAI_API_KEY=your-openai-api-key

# Qdrant vector store URL. Default localhost:6333 for local dev;
# in production set to http://jpos-qdrant.internal:6333
QDRANT_URL=http://localhost:6333

# Embedding model (default text-embedding-3-small, 1536 dims)
MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Dedup LLM model — used once per remember() to decide ADD vs REPLACE vs NOOP
# against near-neighbor existing memories. Default gpt-4.1-nano (cheapest).
MEMORY_DEDUP_MODEL=gpt-4.1-nano

# Server Port
PORT=3000

# App Store Connect API (optional - tools disabled if not set)
# Get these from App Store Connect > Users & Access > Integrations > App Store Connect API
APP_STORE_CONNECT_KEY_ID=your-key-id
APP_STORE_CONNECT_ISSUER_ID=your-issuer-id
# Contents of the .p8 private key file (paste the full key including BEGIN/END lines)
APP_STORE_CONNECT_P8_KEY=your-p8-key-contents
# Find in App Store Connect > Payments and Financial Reports
APP_STORE_CONNECT_VENDOR_NUMBER=your-vendor-number

# Google Calendar (optional — tools disabled if not all three are set)
# 1. Create an OAuth Desktop client in Google Cloud Console; copy ID + secret here.
# 2. Publish the OAuth app to "In production" (else refresh tokens expire in 7 days).
# 3. Run: npx tsx scripts/google-oauth-bootstrap.ts — paste the printed refresh token here.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Structured-data store (SQLite/libSQL). Default: file:/data/jpos.db (Fly volume).
# For local dev use a path under the repo (gitignored): file:./data/jpos.db
DATABASE_URL=file:./data/jpos.db

# Litestream continuous backup (optional — disabled unless LITESTREAM_BUCKET is set).
# Streams /data/jpos.db to an S3-compatible bucket for point-in-time restore.
# For Fly Tigris: endpoint=https://fly.storage.tigris.dev, region=auto.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://fly.storage.tigris.dev
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
